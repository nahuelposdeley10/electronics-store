# ── Credenciales de Mercado Pago ──────────────────────────────────────────────
# El Access Token es SECRETO: solo vive en el backend, jamas en el frontend.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secreto de firma de webhooks (Dashboard MP > Tu integracion > Webhooks > Signature secret).
# Sin el, el server rechaza las notificaciones (503) para no procesar requests no firmadas.
MP_WEBHOOK_SECRET=

# ── Base de datos ─────────────────────────────────────────────────────────────
# Conexion a MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Retencion (en dias) de movimientos de stock y de caja. Los documentos viejos
# se borran con un indice TTL. Default: 365.
MOVEMENT_RETENTION_DAYS=365

# ── URLs del frontend y del backend ───────────────────────────────────────────
# - En dev: CLIENT_URL=http://localhost:5173  y  SERVER_URL=http://localhost:4000
# - En produccion: las URLs reales del deploy
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Puerto del backend (solo afecta `npm start` / `npm run server`). Default: 4000.
PORT=4000

# Origenes CORS extra (separados con coma). CLIENT_URL siempre esta permitido.
# Se usa para aceptar peticiones de otros dominios, p. ej. otra tienda en un subdominio.
# CORS_ORIGINS=https://tienda2.midominio.com,https://tienda3.midominio.com

# Limite del cuerpo JSON (upload y formularios). Default: 100kb.
# BODY_LIMIT=2mb

# ── Panel de administracion ───────────────────────────────────────────────────
# Secreto para firmar los JWT del panel.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En produccion es OBLIGATORIO; sin el, el server no arranca.
JWT_SECRET=

# Cloudinary (imagenes de los productos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Usuarios iniciales del panel ──────────────────────────────────────────────
# Se crean/actualizan con `npm run seed:users`. La DB queda con las passwords que
# definas aca (o que escribas con `npm run seed:users -- --ask`).
# OJO: si cambiaste passwords a mano en la DB, correr seed:users las reescribe
# con las de este archivo. Para resetear todas al vuela, usá --ask.
SUPERADMIN_NAME=Dueño
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Tienda principal (slug que arma la URL publica /u/<slug>)
ADMIN_BUSINESS_SLUG=
ADMIN_NAME=Encargado
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Usuario operador (opcional; se le asigna la tienda del ADMIN_* de arriba)
OPERATOR_NAME=Operador
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# Base (database name) usada por seed-users y seed. Default: electronics-store.
# Solo tocar si queres sembrar datos en otra base, p. ej. un staging.
# SEED_DB_NAME=electronics-store